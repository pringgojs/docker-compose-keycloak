{
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  },
  "name": "keycloak",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:asn-v2": "tailwindcss -c keycloak/themes/asn-v2/tailwind.config.js -i keycloak/themes/asn-v2/login/resources/css/input.css -o keycloak/themes/asn-v2/login/resources/css/styles.css --minify",
    "watch:asn-v2": "tailwindcss -c keycloak/themes/asn-v2/tailwind.config.js -i keycloak/themes/asn-v2/login/resources/css/input.css -o keycloak/themes/asn-v2/login/resources/css/styles.css --watch",
    "build:agustusan": "tailwindcss -c keycloak/themes/agustusan-2026/tailwind.config.js -i keycloak/themes/agustusan-2026/login/resources/css/input.css -o keycloak/themes/agustusan-2026/login/resources/css/styles.css --minify",
    "watch:agustusan": "tailwindcss -c keycloak/themes/agustusan-2026/tailwind.config.js -i keycloak/themes/agustusan-2026/login/resources/css/input.css -o keycloak/themes/agustusan-2026/login/resources/css/styles.css --watch",
    "preview:agustusan": "node keycloak/themes/agustusan-2026/preview/build-preview.js",
    "build:pramana": "tailwindcss -c keycloak/themes/pramana-citizen/tailwind.config.js -i keycloak/themes/pramana-citizen/login/resources/css/input.css -o keycloak/themes/pramana-citizen/login/resources/css/styles.css --minify",
    "watch:pramana": "tailwindcss -c keycloak/themes/pramana-citizen/tailwind.config.js -i keycloak/themes/pramana-citizen/login/resources/css/input.css -o keycloak/themes/pramana-citizen/login/resources/css/styles.css --watch",
    "preview:pramana": "node keycloak/themes/pramana-citizen/preview/build-preview.js",
    "build:sumpah-pemuda": "tailwindcss -c keycloak/themes/sumpah-pemuda-2026/tailwind.config.js -i keycloak/themes/sumpah-pemuda-2026/login/resources/css/input.css -o keycloak/themes/sumpah-pemuda-2026/login/resources/css/styles.css --minify",
    "build:hari-pahlawan": "tailwindcss -c keycloak/themes/hari-pahlawan-2026/tailwind.config.js -i keycloak/themes/hari-pahlawan-2026/login/resources/css/input.css -o keycloak/themes/hari-pahlawan-2026/login/resources/css/styles.css --minify",
    "build": "npm run build:asn-v2 && npm run build:agustusan && npm run build:pramana && npm run build:sumpah-pemuda && npm run build:hari-pahlawan",
    "build:kisara": "tailwindcss -c keycloak/themes/kisara/tailwind.config.js -i keycloak/themes/kisara/login/resources/css/input.css -o keycloak/themes/kisara/login/resources/css/styles.css --minify",
    "preview:kisara": "node keycloak/themes/kisara/preview/build-preview.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pringgojs/docker-compose-keycloak.git"
  },
  "keywords": [],
